
{
  "$schema": "https://opencode.ai/config.json",

  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    }
  ],

  "mcp": {
    "servers": {
      "wow": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "hated-wow-mcp"
        ],
        "environment": {
          "WOW_DEFAULT_FLAVOR": "forever"
        }
      }
    }
  }
}
